{
  "name": "litenote",
  "version": "0.1.0",
  "private": true,
  "description": "A modern and simple note taking app built with electron and react",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test"
  },
  "build": {
    "productName": "litenote",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "resources/icon.png"
    ]
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/material": "^9.5.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
